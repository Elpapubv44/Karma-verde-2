# API key for the optional Gemini QR analysis service.
GEMINI_API_KEY=your_gemini_api_key

# Public browser URL for the PHP API. Leave blank to use the app's local mock mode.
VITE_API_BASE_URL=http://localhost/php-api

# Server-only secrets. Generate unique values for every deployed environment.
PASSWORD_PEPPER=replace_with_a_random_string_of_at_least_32_characters
QR_SECRET=replace_with_a_different_random_secret_for_qr_signatures
KARMAVERDE_CREATOR_CODE=replace_with_creator_registration_code
KARMAVERDE_SUPERIOR_CODE=replace_with_superior_registration_code
KARMAVERDE_ASOCIADO_CODE=replace_with_partner_registration_code

# MySQL connection settings (server-only; do not expose these variables to Vite).
DB_HOST=localhost
DB_NAME=karmaverde
DB_USER=root
DB_PASS=change_me

# Exact public origin allowed to send credentialed requests to the PHP API.
FRONTEND_URL=http://localhost:3000
